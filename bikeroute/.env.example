# Firebase (client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Maps — OpenFreeMap works without a key. Replace for production tiles.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Routing — OpenRouteService API key from https://openrouteservice.org/
# Prefer a Cloud Functions proxy in production (do not expose keys long-term).
VITE_ROUTING_PROVIDER=openrouteservice
VITE_ROUTING_API_KEY=
# Optional proxy base URL, e.g. https://us-central1-PROJECT.cloudfunctions.net/routing
VITE_ROUTING_PROXY_URL=
VITE_USE_ROUTING_PROXY=false

# Geocoding contact email recommended by Nominatim usage policy
VITE_GEOCODER_CONTACT_EMAIL=

# Future Stripe (server-side only — never put secret keys in VITE_*)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# VITE_STRIPE_PUBLISHABLE_KEY=
