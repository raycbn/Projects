# ============================================================
# PedalMap — environment variables
# Copy to .env.local and fill values. Never commit secrets.
# ============================================================

# Firebase Web (client) — Spark/free is enough
VITE_FIREBASE_API_KEY=
# On Hosting (*.web.app) the app overrides this to the current hostname
# so Google redirect login stays first-party on mobile.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudflare Worker API (ORS proxy + Stripe) — FREE tier, no Firebase Blaze
# Local: http://127.0.0.1:8787  |  Prod: https://pedalmap-api.<you>.workers.dev
VITE_PEDALMAP_API_URL=
VITE_ROUTING_PROXY_URL=
VITE_USE_ROUTING_PROXY=true
VITE_ROUTING_PROVIDER=openrouteservice

# ORS key must NOT ship to the browser. Keep it only on the Worker (ORS_API_KEY).
# Emergency local-only bypass (discouraged):
# VITE_ALLOW_DIRECT_ORS=true
# VITE_ORS_API_KEY=

# MapLibre style URL (OpenFreeMap — free, no key)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Nominatim fair-use contact (recommended)
VITE_GEOCODER_CONTACT_EMAIL=

# Stripe TEST / sandbox (publishable only in Vite)
VITE_STRIPE_ENABLED=false
VITE_STRIPE_PUBLISHABLE_KEY=

# Worker secrets (wrangler secret / .dev.vars — NEVER in Vite):
# ORS_API_KEY
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# FIREBASE_SERVICE_ACCOUNT   (JSON service account — free on Spark; needed for webhook→Firestore)
# wrangler.toml vars: STRIPE_PRICE_MONTHLY, STRIPE_PRICE_YEARLY, APP_URL, FIREBASE_PROJECT_ID
