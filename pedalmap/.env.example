# ============================================================
# PedalMap — environment variables
# Copy to .env.local and fill values. Never commit secrets.
# ============================================================

# Firebase Web (client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1

# OpenRouteService — required for real bicycle routing (dev / direct)
# Create a free key at https://openrouteservice.org/
# Prefer Cloud Functions proxy in production (see VITE_USE_ROUTING_PROXY).
VITE_ORS_API_KEY=

# Optional routing proxy (Cloud Functions) for production
VITE_ROUTING_PROVIDER=openrouteservice
VITE_ROUTING_PROXY_URL=
VITE_USE_ROUTING_PROXY=false

# MapLibre style URL (OpenFreeMap — free, no key)
# Swap later without changing MapView code.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Nominatim fair-use contact (recommended)
VITE_GEOCODER_CONTACT_EMAIL=

# Fase 4 — Stripe (client flag; secrets live in Cloud Functions)
VITE_STRIPE_ENABLED=false
VITE_STRIPE_PUBLISHABLE_KEY=

# Cloud Functions secrets (set with firebase functions:secrets:set — never in Vite):
# ORS_API_KEY
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# params: STRIPE_PRICE_MONTHLY, STRIPE_PRICE_YEARLY, APP_URL
