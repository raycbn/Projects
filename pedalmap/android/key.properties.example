# Android Release Keystore Configuration
# Copy this file to key.properties and fill in your values
# DO NOT COMMIT key.properties to git (it's in .gitignore)

# Path to keystore file (relative to android/ directory or absolute path)
# Store the keystore OUTSIDE the repository, e.g. in ~/keystore/pedalmap-release.jks
storeFile=../pedalmap-release.jks

# Keystore password
storePassword=YOUR_STORE_PASSWORD

# Key alias
keyAlias=pedalmap

# Key password
keyPassword=YOUR_KEY_PASSWORD