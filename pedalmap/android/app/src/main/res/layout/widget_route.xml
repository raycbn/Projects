<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b241c"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widgetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PedalMap"
        android:textColor="#d6ff4b"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Qué ruta hacemos hoy?"
        android:textColor="#ffffff"
        android:textSize="14sp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/widgetButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Crear ruta"
        android:textColor="#0b241c"
        android:backgroundTint="#d6ff4b"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

</LinearLayout>
