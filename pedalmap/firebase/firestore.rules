rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidPlan(plan) {
      return plan in ['free', 'premium'];
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isPremiumUser() {
      return ('plan' in userData()) && userData().plan == 'premium';
    }

    function routesSavedCount() {
      // Missing usage must not explode the rule (deny-by-error).
      return ('usage' in userData() && 'routesSaved' in userData().usage)
        ? userData().usage.routesSaved
        : 0;
    }

    /** Free may keep at most 5 saved routes (server-side). */
    function withinSaveLimit() {
      return isPremiumUser() || routesSavedCount() < 5;
    }

    function currentMonthKey() {
      let m = request.time.month();
      return string(request.time.year()) + '-' + (m < 10 ? '0' + string(m) : string(m));
    }

    function usageOk() {
      return !('usage' in request.resource.data)
        || !('usage' in resource.data)
        || (
          request.resource.data.usage.routesSaved >= 0
          && request.resource.data.usage.routesSaved
            <= resource.data.usage.routesSaved + 1
          && request.resource.data.usage.routesSaved
            >= resource.data.usage.routesSaved - 1
          // monthKey may only stay put or advance to the real UTC calendar month.
          && (
            request.resource.data.usage.monthKey == resource.data.usage.monthKey
            || request.resource.data.usage.monthKey == currentMonthKey()
          )
          && (
            // Same month: creates may only stay or +1 (recordRouteCreated).
            (
              request.resource.data.usage.monthKey == resource.data.usage.monthKey
              && request.resource.data.usage.routesCreatedThisMonth
                >= resource.data.usage.routesCreatedThisMonth
              && request.resource.data.usage.routesCreatedThisMonth
                <= resource.data.usage.routesCreatedThisMonth + 1
            )
            // Real month rollover: counter resets to 0, or 1 if combined with first create.
            || (
              request.resource.data.usage.monthKey != resource.data.usage.monthKey
              && request.resource.data.usage.routesCreatedThisMonth >= 0
              && request.resource.data.usage.routesCreatedThisMonth <= 1
            )
          )
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && isValidPlan(request.resource.data.plan);
      // Plan is frozen for clients (Worker/Admin + Stripe only).
      // Usage may change by at most ±1 on routesSaved (save/delete).
      allow update: if isOwner(userId)
        && request.resource.data.plan == resource.data.plan
        && usageOk();
      allow delete: if isOwner(userId);
    }

    match /publicProfiles/{userId} {
      allow read: if resource.data.isPublic == true || isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /routes/{routeId} {
      allow read: if resource.data.isPublic == true || isOwner(resource.data.userId);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && withinSaveLimit();
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /routeShares/{shareSlug} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      // Updates must keep the existing owner — prevent public-slug hijack via userId swap.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /favorites/{userId}/items/{routeId} {
      allow read, write: if isOwner(userId);
    }

    match /activities/{activityId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /follows/{userId}/following/{followeeId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /follows/{userId}/followers/{followerId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == followerId;
    }

    match /segments/{segmentId} {
      allow read: if resource.data.isPublic == true || (isSignedIn() && resource.data.createdBy == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /segmentEfforts/{effortId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /challenges/{challengeId} {
      allow read: if resource.data.isPublic == true || (isSignedIn() && resource.data.createdBy == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /challengeEntries/{entryId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /rankings/{boardId}/entries/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
  }
}
